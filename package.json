{
  "name": "storm-call-3",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -- next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check --write",
    "format": "biome format --write",
    "check:all": "bunx tsc --noEmit && bunx biome check --write && bunx biome format --write",
    "check:ci": "bunx tsc --noEmit && bunx biome check && bunx biome format",
    "initialize-workspace": "./scripts/initialize-workspace.sh",
    "stop-workspace": "./scripts/stop-workspace.sh",
    "get-dev-port": "dotenv -- node -e \"console.log(process.env.PORT ?? '')\"",
    "get-db-port": "dotenv -- node -e \"console.log(process.env.DATABASE_PORT ?? '')\"",
    "get-minio-api-port": "dotenv -- node -e \"console.log(process.env.MINIO_API_PORT ?? '')\"",
    "get-minio-console-port": "dotenv -- node -e \"console.log(process.env.MINIO_CONSOLE_PORT ?? '')\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test:parallel": "bun test --concurrent --max-concurrency 32"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-query": "^5.100.9",
    "@trpc/client": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "@trpc/tanstack-react-query": "^11.17.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "libphonenumber-js": "^1.12.43",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.11.0",
    "recharts": "3.8.0",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@tanstack/react-query-devtools": "^5.100.9",
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "^1.3.13",
    "@types/node": "^20.19.40",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
