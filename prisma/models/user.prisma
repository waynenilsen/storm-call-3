model User {
  id             String               @id @default(cuid())
  name           String
  email          String               @unique
  passwordHash   String
  adminRole      String?
  employeeId     String?
  employee       Employee?            @relation("UserEmployeeLink", fields: [employeeId], references: [id], onDelete: SetNull)
  selectedOrganizationId String?
  selectedOrganization Organization?   @relation("UserSelectedOrganization", fields: [selectedOrganizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  memberships    UserOrganization[]
  sessions       Session[]
  employeesCreated Employee[]        @relation("EmployeeCreatedBy")
  employeesUpdated Employee[]        @relation("EmployeeUpdatedBy")
  calloutsCreated  Callout[]         @relation("CalloutCreatedBy")
  calloutsUpdated  Callout[]         @relation("CalloutUpdatedBy")
}

model Organization {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  url         String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  memberships UserOrganization[]
  employees   Employee[]
  callouts    Callout[]
  usersHavingSelectedOrganization User[] @relation("UserSelectedOrganization")
}

model UserOrganization {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId])
}
