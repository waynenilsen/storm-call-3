model User {
  id                     String             @id @default(cuid())
  name                   String
  email                  String             @unique
  passwordHash           String
  adminRole              String?
  contactId              String?
  contact                Contact?           @relation("UserContactLink", fields: [contactId], references: [id], onDelete: SetNull)
  selectedOrganizationId String?
  selectedOrganization   Organization?      @relation("UserSelectedOrganization", fields: [selectedOrganizationId], references: [id], onDelete: SetNull)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  memberships            UserOrganization[]
  sessions               Session[]
  contactsCreated        Contact[]          @relation("ContactCreatedBy")
  contactsUpdated        Contact[]          @relation("ContactUpdatedBy")
  calloutsCreated        Callout[]          @relation("CalloutCreatedBy")
  calloutsUpdated        Callout[]          @relation("CalloutUpdatedBy")
  equipmentCreated       Equipment[]        @relation("EquipmentCreatedBy")
  equipmentUpdated       Equipment[]        @relation("EquipmentUpdatedBy")
  messagesSent           Message[]          @relation("MessageSentBy")
  activities             Activity[]         @relation("ActivityActor")
}

model Organization {
  id                              String             @id @default(cuid())
  name                            String
  slug                            String             @unique
  url                             String?
  createdAt                       DateTime           @default(now())
  updatedAt                       DateTime           @updatedAt
  memberships                     UserOrganization[]
  contacts                        Contact[]
  callouts                        Callout[]
  conversations                   Conversation[]
  equipment                       Equipment[]
  messages                        Message[]
  activities                      Activity[]
  usersHavingSelectedOrganization User[]             @relation("UserSelectedOrganization")
}

model UserOrganization {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId])
}
